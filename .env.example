# Local dev server port (ignored on Vercel)
PORT=4000

# Session signing secret — set a long random value in production (Vercel env vars).
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: override the hardcoded login. Defaults to
# trustpatrick@gmail.com / trustpatrick88 if unset.
LOGIN_EMAIL=trustpatrick@gmail.com
LOGIN_PASSWORD=trustpatrick88

# GHL credentials for production (Vercel serverless has no persistent disk,
# so these MUST be set as env vars there — the in-app Connect form only
# persists locally). Leave unset locally to use the Connect form instead.
# GHL_LOCATION_ID=
# GHL_PRIVATE_TOKEN=
