# Copy to .env for local dev. On Railway, set these in the service's
# Variables tab instead — do not commit a real .env file.

# Required in production so cookies get the Secure flag.
NODE_ENV=production

# Railway injects PORT automatically; only needed for local dev overrides.
# PORT=4000

# GoHighLevel credentials. If both are set, Settings become read-only
# ("managed by environment") and the /api/settings save endpoint is disabled.
GHL_LOCATION_ID=
GHL_PRIVATE_TOKEN=

# Login for the single hardcoded account. Change these in production.
LOGIN_EMAIL=trustpatrick@gmail.com
LOGIN_PASSWORD=trustpatrick88

# Secret used to sign session cookies. MUST be set to a long random value in
# production — the code falls back to an insecure dev-only default otherwise.
AUTH_SECRET=

# Comma-separated list of frontend origins allowed to call this API with
# credentials, e.g. https://myapp.vercel.app,https://myapp.com
# Leave unset during local dev to allow any origin.
ALLOWED_ORIGINS=
